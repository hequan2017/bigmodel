# 复制后按需修改并 export；本项目不自动加载该文件。
APP_HTTP_ADDR=:8080
DATABASE_URL=postgres://bigmodel:bigmodel@localhost:5432/bigmodel?sslmode=disable
APP_DATA_DIR=./data
APP_LOG_LEVEL=info
APP_SESSION_TTL=12h
APP_RUN_TIMEOUT=180s

# 模型服务（OpenAI 兼容协议）；未配置时对应功能明确报告不可用
APP_CHAT_BASE_URL=
APP_CHAT_API_KEY=
APP_CHAT_MODEL=
APP_EMBEDDING_BASE_URL=
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=

# 初始化演示账号口令（仅 go run ./cmd/seed 使用）
APP_SEED_ADMIN_PASSWORD=admin@123
APP_SEED_TEACHER_PASSWORD=teacher@123
APP_SEED_STUDENT_PASSWORD=student@123
